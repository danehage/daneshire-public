# Git
.git
.gitignore

# Environment files
# (**/ so backend/.env is excluded too — a bare ".env*" only matches the root)
**/.env*
!**/.env.example

# Python
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.coverage
htmlcov
*.egg-info
**/.venv
**/venv
**/scanner_cache
backend/scripts/backtest/cache
backend/scripts/backtest/output

# Node
**/node_modules
frontend/dist

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation (not needed in container)
*.md
!frontend/README.md

# Tests (not needed in production)
backend/tests
.pytest_cache

# Legacy code
legacy

# Claude Code
.claude

# Local development
docker-compose.yml
backend/Dockerfile
frontend/Dockerfile
