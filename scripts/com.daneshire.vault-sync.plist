<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daneshire vault sync — runs scripts/sync_vault.py every 20 minutes.

  Install:
    cp scripts/com.daneshire.vault-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.daneshire.vault-sync.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.daneshire.vault-sync.plist

  Adjust the two paths below if the repo lives somewhere other than
  ~/Developer/daneshire. Credentials come from backend/.env (AUTH_USERNAME /
  AUTH_PASSWORD) via the script's fallback, so nothing secret lives here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daneshire.vault-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USERNAME/Developer/daneshire/scripts/sync_vault.py</string>
  </array>
  <key>StartInterval</key>
  <integer>1200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/daneshire-vault-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/daneshire-vault-sync.err</string>
</dict>
</plist>
